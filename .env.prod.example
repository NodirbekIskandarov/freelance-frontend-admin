# Serverdagi `.env` uchun namuna (/var/www/yopamiz-front/freelance-frontend-admin/.env).
# Bu fayl `docker-compose.prod.yml` tomonidan build args sifatida o'qiladi.
# DIQQAT: VITE_* build paytida bundle'ga yoziladi — o'zgartirgandan keyin qayta
# build kerak (deploy workflow `--build` bilan ishga tushadi).

# Backend API manzili. Ikki yo'ldan biri tanlanadi:
#
# 1) Nisbiy (TAVSIYA): VITE_API_URL=/api/v1
#    So'rov admin domeniga ketadi, konteyner ichidagi nginx uni
#    API_UPSTREAM ga uzatadi. So'rov same-origin bo'lgani uchun backendda
#    CORS ro'yxatiga hech narsa qo'shish shart emas.
#
# 2) To'g'ridan-to'g'ri: VITE_API_URL=https://api.yopamiz.uz/api/v1
#    Bunda backend CORS ro'yxatida admin domeni BO'LISHI SHART, aks holda
#    brauzer barcha so'rovlarni bloklaydi.
#
# Ikkala holatda ham `/api/v1` bilan tugashi kerak: endpoint'lar
# `/api/v1/admin/...` ko'rinishida (Swagger'ga qarang). `/api` bilan
# tugatilsa har bir so'rov 404 qaytaradi.
VITE_API_URL=/api/v1

# Faqat nisbiy VITE_API_URL uchun: nginx qaysi backendga proksilaydi.
API_UPSTREAM=https://api.yopamiz.uz

# Host porti (nginx/reverse proxy shu portga yo'naltiradi).
ADMIN_PORT=8091
