# API manzili — nisbiy yo'l.
# Dev'da Vite proksisi orqali https://api.yopamiz.uz ga boradi (vite.config.ts).
# Production'da admin API bilan bir domenda turadi yoki bu qiymat to'liq
# manzilga almashtiriladi.
VITE_API_URL=/api/v1

# MSW mock API. Hali backendda tayyor bo'lmagan endpoint'lar uchun yoqilgan.
# Mock qilinmagan yo'llar (yechim moderatsiyasi) haqiqiy serverga o'tadi.
VITE_ENABLE_MOCKS=true
